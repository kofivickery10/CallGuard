# ─────────────────────────────────────────────────────────────────────────
# CallGuard ops tools (the callguard-ops MCP server). Copy to
# tools/ops-mcp/.env and fill in only the sources you use; the `health` tool
# reports what is still missing. This file is separate from the repo-root .env
# on purpose: every credential here should be read-only and narrower than the
# app's own. Never reuse the app's DATABASE_URL or scoring/transcription keys.
#
# Values already set in your shell take precedence over this file.
# ─────────────────────────────────────────────────────────────────────────

# ── CallGuard database metrics ───────────────────────────────────────────────
# A Postgres role with SELECT only, on only the tables the metrics read.
OPS_DATABASE_URL=

# ── Anthropic usage and cost ─────────────────────────────────────────────────
# The usage and cost reports need an Admin API key (sk-ant-admin…). An admin key
# can do more than read; the tools only ever call the report endpoints.
ANTHROPIC_ADMIN_API_KEY=

# ── Deepgram usage ───────────────────────────────────────────────────────────
# A key limited to reading usage, separate from the transcription key.
DEEPGRAM_USAGE_API_KEY=
DEEPGRAM_PROJECT_ID=

# ── Google Search Console and Google Analytics 4 ─────────────────────────────
# One service account serves both. Keep its JSON key OUTSIDE the repo (e.g.
# ~/.config/callguard/google-service-account.json, chmod 600); `health` refuses a
# path inside the working tree. Add the account's …iam.gserviceaccount.com email
# as a Restricted user in Search Console and a Viewer in GA4.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Domain property: sc-domain:callguardai.co.uk  URL-prefix: https://callguardai.co.uk/
GSC_SITE_URL=
GA4_PROPERTY_ID=

# ── Companies House ──────────────────────────────────────────────────────────
COMPANIES_HOUSE_API_KEY=

# ── FCA Financial Services Register ──────────────────────────────────────────
# The same email + key pair as the repo-root .env's prospecting scripts.
FCA_API_EMAIL=
FCA_API_KEY=
